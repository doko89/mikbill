# Contoh env Mikbil — salin ke /etc/mikbil/mikbil.env lalu isi.
# Kunci enkripsi: hasil perintah `mikbil genkey` (hex 64 char). WAJIB sama
# di tiap restart; ganti kunci membuat secret tersimpan tak terbaca.
MIKBIL_ADDR=127.0.0.1:8080
MIKBIL_DB=/var/lib/mikbil/mikbil.db
MIKBIL_ENC_KEY=GANTI_DENGAN_HASIL_MIKBIL_GENKEY
# Debug API KrisKris (opsional): 1 = catat request/response ke log, secret disamarkan.
# MIKBIL_DEBUG_KRISKRIS=1
